MAIL_DIR /var/mail
FAIL_DELAY 3
LOG_UNKFAIL_ENAB no
LOG_OK_LOGINS yes
UID_MIN 1000
UID_MAX 60000
GID_MIN 1000
GID_MAX 60000
SYS_UID_MIN 101
SYS_UID_MAX 999
SYS_GID_MIN 101
SYS_GID_MAX 999
CREATE_HOME yes
USERGROUPS_ENAB yes
UMASK 077
ENCRYPT_METHOD YESCRYPT
PASS_MAX_DAYS 99999
PASS_MIN_DAYS 0
PASS_WARN_AGE 7
ENV_PATH PATH=/usr/local/bin:/usr/bin:/bin
ENV_SUPATH PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
