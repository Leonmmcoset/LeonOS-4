# Minimal static BusyBox profile for the LeonOS userland ABI.
#
# Hush runs behind BusyBox's `sh` entry. Its jobs and pipelines use the native
# fork/exec, process-group, PTY and waitpid implementation.
CONFIG_BUSYBOX=y
CONFIG_STATIC=y
# LeonOS has a paged x86_64 address space.  Hush must use its MMU fork path
# so pipelines, background jobs and process groups exercise the native COW
# implementation instead of the NOMMU vfork/re-exec fallback.
# CONFIG_NOMMU is not set
CONFIG_INSTALL_APPLET_SYMLINKS=n
CONFIG_INSTALL_APPLET_HARDLINKS=n
CONFIG_INSTALL_APPLET_SCRIPT_WRAPPERS=n
CONFIG_INSTALL_APPLET_DONT=y
CONFIG_EXTRA_LDLIBS="leonos"
CONFIG_DESKTOP=n
CONFIG_INCLUDE_SUSv2=n
CONFIG_LONG_OPTS=y
CONFIG_SHOW_USAGE=y
CONFIG_FEATURE_VERBOSE_USAGE=n
CONFIG_FEATURE_COMPRESS_USAGE=n
CONFIG_FEATURE_EDITING=n
CONFIG_FEATURE_SUID=n
CONFIG_FEATURE_SYSLOG=n
CONFIG_FEATURE_CLEAN_UP=n
CONFIG_FEATURE_DEVPTS=n
CONFIG_FEATURE_UTMP=n
CONFIG_FEATURE_WTMP=n
CONFIG_FEATURE_PIDFILE=n
CONFIG_FEATURE_SEAMLESS_XZ=n
CONFIG_FEATURE_SEAMLESS_LZMA=n
CONFIG_FEATURE_SEAMLESS_BZ2=n
CONFIG_FEATURE_SEAMLESS_GZ=n
CONFIG_FEATURE_SEAMLESS_Z=n
CONFIG_FEATURE_BUFFERS_USE_MALLOC=y
# Hush uses the native fork/exec, process-group, PTY and waitpid ABI. Keeping
# this enabled exercises the same job-control path used by external programs.
CONFIG_ASH=n
CONFIG_SH_IS_ASH=n
CONFIG_HUSH=y
CONFIG_SH_IS_HUSH=y
CONFIG_SH_IS_NONE=n
CONFIG_FEATURE_SH_STANDALONE=y
CONFIG_FEATURE_SH_NOFORK=n
CONFIG_HUSH_JOB=y
CONFIG_HUSH_WAIT=y
CONFIG_HUSH_TICK=n
CONFIG_HUSH_IF=n
CONFIG_HUSH_LOOPS=n
CONFIG_HUSH_CASE=n
CONFIG_HUSH_FUNCTIONS=n
CONFIG_HUSH_LOCAL=n
CONFIG_HUSH_RANDOM=n
CONFIG_HUSH_EXPORT_N=n
CONFIG_HUSH_MODE_X=n
CONFIG_HUSH_INTERACTIVE=y
CONFIG_HUSH_HELP=y
CONFIG_HUSH_PRINTF=n
CONFIG_HUSH_TEST=n
CONFIG_CAT=y
# CONFIG_FEATURE_CATN is not set
CONFIG_FEATURE_CATV=n
CONFIG_ECHO=y
CONFIG_FEATURE_FANCY_ECHO=y
CONFIG_LS=y
CONFIG_FEATURE_LS_FILETYPES=y
CONFIG_FEATURE_LS_FOLLOWLINKS=n
CONFIG_FEATURE_LS_RECURSIVE=n
CONFIG_FEATURE_LS_WIDTH=n
CONFIG_FEATURE_LS_SORTFILES=y
CONFIG_FEATURE_LS_TIMESTAMPS=n
CONFIG_FEATURE_LS_USERNAME=n
CONFIG_FEATURE_LS_COLOR=y
CONFIG_FEATURE_LS_COLOR_IS_DEFAULT=y
CONFIG_PWD=y
CONFIG_CLEAR=y
CONFIG_HEAD=y
CONFIG_FEATURE_FANCY_HEAD=y
CONFIG_TAIL=y
CONFIG_FEATURE_FANCY_TAIL=y
CONFIG_WC=y
CONFIG_GREP=y
CONFIG_FEATURE_GREP_CONTEXT=y
CONFIG_TRUE=y
CONFIG_FALSE=y
CONFIG_BASENAME=y
CONFIG_DIRNAME=y
CONFIG_PRINTF=y
CONFIG_MKDIR=y
CONFIG_RMDIR=y
CONFIG_CP=y
CONFIG_FEATURE_CP_LONG_OPTIONS=n
CONFIG_FEATURE_CP_REFLINK=n
CONFIG_MV=y
CONFIG_RM=y
CONFIG_PRINTENV=y
CONFIG_UNAME=y
CONFIG_UNAME_OSNAME="LeonOS"
CONFIG_SLEEP=y
CONFIG_PS=y
CONFIG_KILL=y
CONFIG_KILLALL=n
CONFIG_KILLALL5=n
CONFIG_FEATURE_FANCY_SLEEP=n
CONFIG_UNLINK=y
CONFIG_DIFF=y
CONFIG_FEATURE_DIFF_LONG_OPTIONS=n
CONFIG_FEATURE_DIFF_DIR=n
CONFIG_LESS=y
# Keep the pager bounded on the current fixed user-space address budget.  The
# full BusyBox less default (9,999,999 lines) can otherwise exhaust memory
# before a user has an opportunity to quit a malformed or giant text file.
CONFIG_FEATURE_LESS_MAXLINES=8192
CONFIG_FEATURE_LESS_BRACKETS=n
CONFIG_FEATURE_LESS_FLAGS=n
CONFIG_FEATURE_LESS_TRUNCATE=n
CONFIG_FEATURE_LESS_MARKS=n
CONFIG_FEATURE_LESS_REGEXP=n
CONFIG_FEATURE_LESS_WINCH=n
CONFIG_FEATURE_LESS_ASK_TERMINAL=n
CONFIG_FEATURE_LESS_DASHCMD=n
CONFIG_FEATURE_LESS_LINENUMS=n
CONFIG_FEATURE_LESS_RAW=n
CONFIG_FEATURE_LESS_ENV=n
CONFIG_VI=y
CONFIG_FEATURE_VI_MAX_LEN=256
CONFIG_FEATURE_VI_8BIT=n
CONFIG_FEATURE_VI_COLON=y
CONFIG_FEATURE_VI_COLON_EXPAND=n
CONFIG_FEATURE_VI_YANKMARK=y
CONFIG_FEATURE_VI_SEARCH=y
CONFIG_FEATURE_VI_REGEX_SEARCH=n
CONFIG_FEATURE_VI_USE_SIGNALS=n
CONFIG_FEATURE_VI_DOT_CMD=y
CONFIG_FEATURE_VI_READONLY=y
CONFIG_FEATURE_VI_SETOPTS=y
CONFIG_FEATURE_VI_SET=y
CONFIG_FEATURE_VI_WIN_RESIZE=y
CONFIG_FEATURE_VI_ASK_TERMINAL=n
CONFIG_FEATURE_VI_UNDO=y
CONFIG_FEATURE_VI_UNDO_QUEUE=y
CONFIG_FEATURE_VI_UNDO_QUEUE_MAX=256
CONFIG_FEATURE_VI_VERBOSE_STATUS=y
# CONFIG_TEST is not set
# CONFIG_FEATURE_TEST_64 is not set
