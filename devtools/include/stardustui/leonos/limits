#pragma once

#include <stdint.h>

namespace std {
template <typename T>
struct numeric_limits {
    static constexpr T min() noexcept { return static_cast<T>(0); }
    static constexpr T max() noexcept { return static_cast<T>(~static_cast<T>(0)); }
};

template <>
struct numeric_limits<int> {
    static constexpr int min() noexcept { return (-2147483647 - 1); }
    static constexpr int max() noexcept { return 2147483647; }
};
}
