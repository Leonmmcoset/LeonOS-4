#pragma once

namespace std {
template <typename T>
T&& move(T& value) noexcept { return static_cast<T&&>(value); }

template <typename T>
const T&& move(const T& value) noexcept { return static_cast<const T&&>(value); }

template <typename T>
T&& forward(T& value) noexcept { return static_cast<T&&>(value); }

template <typename T>
void swap(T& left, T& right) noexcept {
    T temporary = static_cast<T&&>(left);
    left = static_cast<T&&>(right);
    right = static_cast<T&&>(temporary);
}
}
