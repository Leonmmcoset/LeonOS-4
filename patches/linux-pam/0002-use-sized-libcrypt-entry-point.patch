 endif
 crypt_h = cdata.get('HAVE_CRYPT_H') == 1 ? '''#include <crypt.h>''' : '''#include <unistd.h>'''
-foreach f: ['crypt_r']
+foreach f: ['crypt_r', 'crypt_rn']
   if cc.has_function(f, prefix: crypt_h,
