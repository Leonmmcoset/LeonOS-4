diff --git a/libpam/include/pam_crypt.h b/libpam/include/pam_crypt.h
--- /dev/null
+++ b/libpam/include/pam_crypt.h
@@ -0,0 +1,22 @@
+#ifndef PAM_CRYPT_H
+#define PAM_CRYPT_H
+
+#include "config.h"
+#include <crypt.h>
+
+#ifdef HAVE_CRYPT_R
+static inline char *
+pam_crypt_r(const char *password, const char *setting, struct crypt_data *data)
+{
+#ifdef HAVE_CRYPT_RN
+	/* A module loaded after musl must not resolve crypt_r to libc's
+	 * smaller hash implementation. The sized libxcrypt API is distinct
+	 * and retains its NULL-on-error and caller-owned-buffer contract. */
+	return crypt_rn(password, setting, data, sizeof(*data));
+#else
+	return crypt_r(password, setting, data);
+#endif
+}
+#endif
+
+#endif
