diff --git a/src/passwd/lckpwdf.c b/src/passwd/lckpwdf.c
--- a/src/passwd/lckpwdf.c
+++ b/src/passwd/lckpwdf.c
@@ -1,11 +1,73 @@
 #include <shadow.h>
+#include <errno.h>
+#include <fcntl.h>
+#include <pthread.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+
+/* musl's upstream stub is insufficient for concurrent pam_unix updates.
+ * Use the same persistent /etc/.pwd.lock inode and POSIX lock as other
+ * shadow writers. Never unlink it, including on errors or unlock. */
+static pthread_mutex_t guard = PTHREAD_MUTEX_INITIALIZER;
+static int lockfd = -1;
 
 int lckpwdf()
 {
-	return 0;
+	int oldstate, fd = -1, result = -1, error;
+	struct stat st;
+	struct timespec deadline, now;
+	struct flock lock = { .l_type = F_WRLCK, .l_whence = SEEK_SET };
+	pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &oldstate);
+	pthread_mutex_lock(&guard);
+	if (lockfd >= 0) { errno = EBUSY; goto out; }
+	fd = open("/etc/.pwd.lock", O_WRONLY|O_CREAT|O_CLOEXEC|O_NOFOLLOW, 0600);
+	if (fd < 0) goto out;
+	if (fstat(fd, &st)) goto out;
+	if (!S_ISREG(st.st_mode) || st.st_uid || (st.st_mode & 0022) || st.st_nlink != 1) {
+		errno = EACCES;
+		goto out;
+	}
+	if (clock_gettime(CLOCK_MONOTONIC, &deadline)) goto out;
+	deadline.tv_sec += 15;
+	for (;;) {
+		if (!fcntl(fd, F_SETLK, &lock)) {
+			lockfd = fd;
+			fd = -1;
+			result = 0;
+			break;
+		}
+		if (errno != EACCES && errno != EAGAIN) goto out;
+		if (clock_gettime(CLOCK_MONOTONIC, &now)) goto out;
+		if (now.tv_sec > deadline.tv_sec || (now.tv_sec == deadline.tv_sec && now.tv_nsec >= deadline.tv_nsec)) {
+			errno = EAGAIN;
+			goto out;
+		}
+		struct timespec pause = { .tv_nsec = 10000000 };
+		if (nanosleep(&pause, 0)) goto out;
+	}
+out:
+	error = errno;
+	if (fd >= 0) close(fd);
+	pthread_mutex_unlock(&guard);
+	pthread_setcancelstate(oldstate, 0);
+	errno = error;
+	return result;
 }
 
 int ulckpwdf()
 {
-	return 0;
+	int oldstate, result, error;
+	pthread_setcancelstate(PTHREAD_CANCEL_DISABLE, &oldstate);
+	pthread_mutex_lock(&guard);
+	if (lockfd < 0) { errno = EINVAL; result = -1; }
+	else {
+		result = close(lockfd);
+		lockfd = -1;
+	}
+	error = errno;
+	pthread_mutex_unlock(&guard);
+	pthread_setcancelstate(oldstate, 0);
+	errno = error;
+	return result;
 }
