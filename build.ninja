ninja_required_version = 1.10
cc = clang
rustc = rustc
ar = llvm-ar
ld = ld.lld

rule kconfig_sync
  command = python3 tools/kconfig_sync.py
  description = KCONFIG sync

rule build_info
  command = python3 tools/build_info.py --header $out --state build/version/build_number.txt
  description = BUILD.INFO $out

rule cc_kernel
  command = $cc -target x86_64-unknown-none -std=c11 -ffreestanding -fno-stack-protector -fno-pic -fno-pie -mno-red-zone -mgeneral-regs-only -mcmodel=kernel -Wall -Wextra -Ikernel/ntclks/include -Iinclude -Iinclude/generated -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CC.KERNEL $out

rule as_kernel
  command = $cc -target x86_64-unknown-none -ffreestanding -mno-red-zone -mgeneral-regs-only -Ikernel/ntclks/include -Iinclude -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = AS.KERNEL $out

rule cc_loader
  command = $cc -target x86_64-unknown-none -std=c11 -ffreestanding -fno-stack-protector -fno-pic -fno-pie -mno-red-zone -mgeneral-regs-only -Wall -Wextra -Iinclude -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CC.LOADER $out

rule as_loader
  command = $cc -target x86_64-unknown-none -ffreestanding -mno-red-zone -mgeneral-regs-only -Iinclude -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = AS.LOADER $out

rule rust_osmlayer
  command = $rustc --crate-type lib --target x86_64-unknown-none -C panic=abort -C relocation-model=static -C code-model=kernel -C no-redzone=yes -C target-feature=-sse,-sse2 -C opt-level=1 --emit obj=$out $in
  description = RUST.OSMLAYER $out

rule link_loader
  command = $ld -nostdlib -z max-page-size=0x1000 -T boot/loader/linker.ld -o $out $in
  description = LD.LOADER $out

rule link_kernel
  command = $ld -nostdlib -z max-page-size=0x1000 -T kernel/ntclks/arch/x86_64/linker.ld -o $out $in
  description = LD.KERNEL $out

rule link_middlelayer
  command = $ld -nostdlib -z max-page-size=0x1000 -T middlelayer/osmlayer/linker.ld -o $out $in
  description = LD.MIDDLELAYER $out

rule cc_user
  command = $cc -target x86_64-unknown-none -std=c11 -ffreestanding -fno-stack-protector -fno-pic -fno-pie -mno-red-zone -mgeneral-regs-only -Wall -Wextra -Iuserland/libc/include -Iinclude -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = CC.USER $out

rule as_user
  command = $cc -target x86_64-unknown-none -ffreestanding -mno-red-zone -mgeneral-regs-only -Iuserland/libc/include -Iinclude -MMD -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc
  description = AS.USER $out

rule ar
  command = $ar rcs $out $in
  description = AR $out

rule link_user
  command = $ld -nostdlib -z max-page-size=0x1000 -T userland/linker.ld -o $out $in
  description = LD.USER $out

rule copy
  command = mkdir -p `dirname $out` && cp $in $out
  description = COPY $out

rule mkdir
  command = mkdir -p $out
  description = MKDIR $out

rule manifest
  command = mkdir -p `dirname $out` && printf 'name=osmlayer\nabi=1\nroot=0:/\nfs=fat32\ngui=desktop.elf\n' > $out
  description = MANIFEST $out

rule grub_efi
  command = mkdir -p `dirname $out` && grub-mkstandalone -d build/deps/grub-efi-amd64-bin/usr/lib/grub/x86_64-efi -O x86_64-efi -o $out --modules='part_gpt fat multiboot2 normal search search_fs_file configfile echo serial terminal video video_bochs video_cirrus efi_gop efi_uga all_video gfxterm' boot/grub/grub.cfg=boot/grub/embedded.cfg
  description = GRUB.EFI $out

rule iso
  command = rm -rf build/iso && mkdir -p build/iso/boot/grub build/iso/boot build/iso/system build/iso/userland build/iso/etc && cp boot/grub/grub.cfg build/iso/boot/grub/grub.cfg && cp build/boot/loader.elf build/iso/boot/loader.elf && cp build/system/kernel.sys build/iso/system/kernel.sys && cp build/system/middlelayer.sys build/iso/system/middlelayer.sys && mkdir -p build/iso/system && cp build/esp/system/osmlayer.manifest build/iso/system/osmlayer.manifest && mkdir -p build/iso/system/fonts && cp build/esp/system/fonts/system.psf build/iso/system/fonts/system.psf && mkdir -p build/iso/system/fonts && cp build/esp/system/fonts/cjk16.lbf build/iso/system/fonts/cjk16.lbf && mkdir -p build/iso/system/resources && cp build/esp/system/resources/mouse.bmp build/iso/system/resources/mouse.bmp && cp build/userland/init.elf build/iso/userland/init.elf && cp build/userland/desktop.elf build/iso/userland/desktop.elf && cp build/userland/oobe.elf build/iso/userland/oobe.elf && cp build/userland/hello.elf build/iso/userland/hello.elf && cp build/userland/uidemo.elf build/iso/userland/uidemo.elf && cp build/userland/cjktest.elf build/iso/userland/cjktest.elf && cp build/userland/taskmgr.elf build/iso/userland/taskmgr.elf && cp build/userland/fileman.elf build/iso/userland/fileman.elf && cp build/userland/terminal.elf build/iso/userland/terminal.elf && cp build/userland/shell.elf build/iso/userland/shell.elf && cp build/userland/notepad.elf build/iso/userland/notepad.elf && cp build/userland/calc.elf build/iso/userland/calc.elf && cp build/userland/minesweeper.elf build/iso/userland/minesweeper.elf && cp build/userland/run.elf build/iso/userland/run.elf && cp build/userland/osver.elf build/iso/userland/osver.elf && cp build/userland/bugtest.elf build/iso/userland/bugtest.elf && cp configs/default.conf build/iso/etc/leonos.conf && grub-mkrescue -o $out build/iso
  description = ISO $out

rule installer_root
  command = python3 tools/make_installer_root.py --out $out --stage build/install/root --esp-tree build/esp
  description = INSTALLER.ROOT $out

rule installer_iso
  command = python3 tools/make_installer_iso.py --out $out --stage build/installer-iso --boot-image build/install/installer-efiboot.img
  description = INSTALLER.ISO $out

rule image
  command = rm -f build/esp/boot/ntclks.elf && python3 tools/make_image.py --out $out --raw build/images/leonos4.raw --esp-tree build/esp
  description = IMAGE $out

rule run
  command = qemu-system-x86_64 -enable-kvm -cpu host -machine q35 -m 512M -bios /usr/share/ovmf/OVMF.fd -serial stdio -display "$${LEONOS_QEMU_DISPLAY:-sdl}" -device VGA,xres=1920,yres=1080 -drive file=build/images/leonos4.vmdk,if=none,id=sata0,format=vmdk -device ich9-ahci,id=ahci -device ide-hd,drive=sata0,bus=ahci.0
  description = RUN LeonOS 4

rule run_debug
  command = qemu-system-x86_64 -enable-kvm -cpu host -machine q35 -m 512M -bios /usr/share/ovmf/OVMF.fd -serial stdio -display none -device VGA,xres=1920,yres=1080 -no-reboot -no-shutdown -drive file=build/images/leonos4.vmdk,if=none,id=sata0,format=vmdk -device ich9-ahci,id=ahci -device ide-hd,drive=sata0,bus=ahci.0
  description = RUN.DEBUG LeonOS 4

rule run_iso
  command = qemu-system-x86_64 -m 512M -serial stdio -display none -device VGA,xres=1920,yres=1080 -no-reboot -no-shutdown -cdrom build/images/leonos4.iso -drive file=build/images/leonos4.vmdk,if=none,id=sata0,format=vmdk -device ich9-ahci,id=ahci -device ide-hd,drive=sata0,bus=ahci.0
  description = RUN.ISO LeonOS 4

rule menuconfig_rule
  command = test -f .config || cp configs/default.conf .config && kconfig-mconf Kconfig && python3 tools/kconfig_sync.py
  description = MENUCONFIG

rule clean_rule
  command = rm -rf build include/generated .config
  description = CLEAN

build include/generated/autoconf.h include/generated/rustcfg.args: kconfig_sync tools/kconfig_sync.py configs/default.conf | .config
build config-sync: phony include/generated/autoconf.h include/generated/rustcfg.args
build build/version/always: phony
build include/generated/build_info.h: build_info build/version/always | tools/build_info.py
build build-info: phony include/generated/build_info.h
build build/obj/loader/boot/loader/boot.S.o: as_loader boot/loader/boot.S
build build/obj/loader/boot/loader/main.c.o: cc_loader boot/loader/main.c
build build/boot/loader.elf: link_loader build/obj/loader/boot/loader/boot.S.o build/obj/loader/boot/loader/main.c.o | boot/loader/linker.ld
build loader: phony build/boot/loader.elf
build build/obj/kernel/kernel/ntclks/arch/x86_64/arch.c.o: cc_kernel kernel/ntclks/arch/x86_64/arch.c | include/generated/autoconf.h
build build/obj/kernel/kernel/ntclks/arch/x86_64/boot.S.o: as_kernel kernel/ntclks/arch/x86_64/boot.S
build build/obj/kernel/kernel/ntclks/arch/x86_64/gdt.c.o: cc_kernel kernel/ntclks/arch/x86_64/gdt.c | include/generated/autoconf.h
build build/obj/kernel/kernel/ntclks/arch/x86_64/idt.c.o: cc_kernel kernel/ntclks/arch/x86_64/idt.c | include/generated/autoconf.h
