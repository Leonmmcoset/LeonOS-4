build build/obj/user-desktop/userland/apps/desktop/input.c.o: cc_user userland/apps/desktop/input.c
build build/obj/user-desktop/userland/apps/desktop/main.c.o: cc_user userland/apps/desktop/main.c
build build/obj/user-desktop/userland/apps/desktop/render.c.o: cc_user userland/apps/desktop/render.c
build build/obj/user-desktop/userland/apps/desktop/screen.c.o: cc_user userland/apps/desktop/screen.c
build build/obj/user-desktop/userland/apps/desktop/start_menu.c.o: cc_user userland/apps/desktop/start_menu.c
build build/obj/user-desktop/userland/apps/desktop/state.c.o: cc_user userland/apps/desktop/state.c
build build/obj/user-desktop/userland/apps/desktop/switcher.c.o: cc_user userland/apps/desktop/switcher.c
