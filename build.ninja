build build/obj/kernel/kernel/ntclks/osmlayer_bridge.c.o: cc_kernel kernel/ntclks/osmlayer_bridge.c | include/generated/autoconf.h
build build/obj/kernel/kernel/ntclks/pty.c.o: cc_kernel kernel/ntclks/pty.c | include/generated/autoconf.h
build build/obj/kernel/kernel/ntclks/sched/sched.c.o: cc_kernel kernel/ntclks/sched/sched.c | include/generated/autoconf.h
build build/obj/kernel/kernel/ntclks/syscall.c.o: cc_kernel kernel/ntclks/syscall.c | include/generated/autoconf.h
build build/obj/kernel/kernel/ntclks/time.c.o: cc_kernel kernel/ntclks/time.c | include/generated/autoconf.h
build build/obj/kernel/kernel/ntclks/user/elf.c.o: cc_kernel kernel/ntclks/user/elf.c | include/generated/autoconf.h
build build/obj/kernel/kernel/ntclks/user/usercopy.c.o: cc_kernel kernel/ntclks/user/usercopy.c | include/generated/autoconf.h
build build/obj/kernel/kernel/ntclks/user/userland.c.o: cc_kernel kernel/ntclks/user/userland.c | include/generated/autoconf.h
build build/obj/kernel/kernel/ntclks/version.c.o: cc_kernel kernel/ntclks/version.c | include/generated/autoconf.h include/generated/build_info.h kernel/ntclks/arch/x86_64/arch.c kernel/ntclks/arch/x86_64/boot.S kernel/ntclks/arch/x86_64/gdt.c kernel/ntclks/arch/x86_64/idt.c kernel/ntclks/arch/x86_64/irq.c kernel/ntclks/arch/x86_64/paging.c kernel/ntclks/arch/x86_64/power.c kernel/ntclks/drivers/console.c kernel/ntclks/drivers/efi_fs.c kernel/ntclks/drivers/framebuffer.c kernel/ntclks/drivers/mouse.c kernel/ntclks/drivers/serial.c kernel/ntclks/drivers/storage.c kernel/ntclks/drivers/vga.c kernel/ntclks/gui_ipc.c kernel/ntclks/input.c kernel/ntclks/kernel.c kernel/ntclks/lib/bugcheck.c kernel/ntclks/lib/panic.c kernel/ntclks/lib/string.c kernel/ntclks/mm/mm.c kernel/ntclks/multiboot2.c kernel/ntclks/osmlayer_bridge.c kernel/ntclks/pty.c kernel/ntclks/sched/sched.c kernel/ntclks/syscall.c kernel/ntclks/time.c kernel/ntclks/user/elf.c kernel/ntclks/user/usercopy.c kernel/ntclks/user/userland.c middlelayer/osmlayer/src/fat32.rs middlelayer/osmlayer/src/gui.rs middlelayer/osmlayer/src/ipc.rs middlelayer/osmlayer/src/lib.rs middlelayer/osmlayer/src/posix.rs middlelayer/osmlayer/src/unicode.rs middlelayer/osmlayer/src/vfs.rs
build build/obj/middlelayer/middlelayer/osmlayer/runtime.c.o: cc_kernel middlelayer/osmlayer/runtime.c | include/generated/autoconf.h
build build/obj/middlelayer/osmlayer.o: rust_osmlayer middlelayer/osmlayer/src/lib.rs | include/generated/rustcfg.args middlelayer/osmlayer/src/fat32.rs middlelayer/osmlayer/src/gui.rs middlelayer/osmlayer/src/ipc.rs middlelayer/osmlayer/src/posix.rs middlelayer/osmlayer/src/unicode.rs middlelayer/osmlayer/src/vfs.rs
build build/system/middlelayer.sys: link_middlelayer build/obj/middlelayer/osmlayer.o build/obj/middlelayer/middlelayer/osmlayer/runtime.c.o | middlelayer/osmlayer/linker.ld
build middlelayer: phony build/system/middlelayer.sys
build build/system/kernel.sys: link_kernel build/obj/kernel/kernel/ntclks/arch/x86_64/arch.c.o build/obj/kernel/kernel/ntclks/arch/x86_64/boot.S.o build/obj/kernel/kernel/ntclks/arch/x86_64/gdt.c.o build/obj/kernel/kernel/ntclks/arch/x86_64/idt.c.o build/obj/kernel/kernel/ntclks/arch/x86_64/irq.c.o build/obj/kernel/kernel/ntclks/arch/x86_64/paging.c.o build/obj/kernel/kernel/ntclks/arch/x86_64/power.c.o build/obj/kernel/kernel/ntclks/drivers/console.c.o build/obj/kernel/kernel/ntclks/drivers/efi_fs.c.o build/obj/kernel/kernel/ntclks/drivers/framebuffer.c.o build/obj/kernel/kernel/ntclks/drivers/mouse.c.o build/obj/kernel/kernel/ntclks/drivers/serial.c.o build/obj/kernel/kernel/ntclks/drivers/storage.c.o build/obj/kernel/kernel/ntclks/drivers/vga.c.o build/obj/kernel/kernel/ntclks/gui_ipc.c.o build/obj/kernel/kernel/ntclks/input.c.o build/obj/kernel/kernel/ntclks/kernel.c.o build/obj/kernel/kernel/ntclks/lib/bugcheck.c.o build/obj/kernel/kernel/ntclks/lib/panic.c.o build/obj/kernel/kernel/ntclks/lib/string.c.o build/obj/kernel/kernel/ntclks/mm/mm.c.o build/obj/kernel/kernel/ntclks/multiboot2.c.o build/obj/kernel/kernel/ntclks/osmlayer_bridge.c.o build/obj/kernel/kernel/ntclks/pty.c.o build/obj/kernel/kernel/ntclks/sched/sched.c.o build/obj/kernel/kernel/ntclks/syscall.c.o build/obj/kernel/kernel/ntclks/time.c.o build/obj/kernel/kernel/ntclks/user/elf.c.o build/obj/kernel/kernel/ntclks/user/usercopy.c.o build/obj/kernel/kernel/ntclks/user/userland.c.o build/obj/kernel/kernel/ntclks/version.c.o | kernel/ntclks/arch/x86_64/linker.ld
build kernel: phony build/system/kernel.sys
build build/obj/userlib/userland/libc/src/crt0.S.o: as_user userland/libc/src/crt0.S
build build/obj/userlib/userland/libc/src/launch.c.o: cc_user userland/libc/src/launch.c
build build/obj/userlib/userland/libc/src/libc.c.o: cc_user userland/libc/src/libc.c
