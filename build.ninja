build build/obj/user-shell/userland/apps/shell/main.c.o: cc_user userland/apps/shell/main.c
build build/userland/shell.elf: link_user build/obj/user-shell/userland/apps/shell/main.c.o build/userland/libc.a
build build/obj/user-notepad/userland/apps/notepad/main.c.o: cc_user userland/apps/notepad/main.c
