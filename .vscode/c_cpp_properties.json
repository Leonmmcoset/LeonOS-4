{
    "version": 4,
    "enableConfigurationSquiggles": true,
    "configurations": [
        {
            "name": "LeonOS Kernel (WSL)",
            "compilerPath": "/usr/bin/clang",
            "intelliSenseMode": "linux-clang-x64",
            "cStandard": "gnu11",
            "compileCommands": "${workspaceFolder}/build/vscode/compile_commands.json",
            "includePath": ["${workspaceFolder}/include", "${workspaceFolder}/build/include", "${workspaceFolder}/build/include/generated", "${workspaceFolder}/kernel/ntclks/include", "${workspaceFolder}/drivers/bootstrap", "${workspaceFolder}/middlelayer/osmlayer"],
            "forcedInclude": ["${workspaceFolder}/build/include/generated/autoconf.h"],
            "defines": ["LEONOS_KERNEL=1"],
            "compilerArgs": ["-target", "x86_64-unknown-none", "-ffreestanding", "-fno-stack-protector", "-fno-pic", "-fno-pie", "-mno-red-zone", "-mgeneral-regs-only", "-mcmodel=kernel", "-Wall", "-Wextra"],
            "browse": {"path": ["${workspaceFolder}/include", "${workspaceFolder}/build/include", "${workspaceFolder}/kernel/ntclks/include"], "limitSymbolsToIncludedHeaders": true}
        },
        {
            "name": "LeonOS Loader (WSL)",
            "compilerPath": "/usr/bin/clang",
            "intelliSenseMode": "linux-clang-x64",
            "cStandard": "gnu11",
            "compileCommands": "${workspaceFolder}/build/vscode/compile_commands.json",
            "includePath": ["${workspaceFolder}/include", "${workspaceFolder}/build/include", "${workspaceFolder}/build/include/generated", "${workspaceFolder}/boot/loader"],
            "defines": ["LEONOS_LOADER=1"],
            "compilerArgs": ["-target", "x86_64-unknown-none", "-ffreestanding", "-fno-stack-protector", "-fno-pic", "-fno-pie", "-mno-red-zone", "-mgeneral-regs-only", "-Wall", "-Wextra"],
            "browse": {"path": ["${workspaceFolder}/include", "${workspaceFolder}/build/include", "${workspaceFolder}/boot/loader"], "limitSymbolsToIncludedHeaders": true}
        },
        {
            "name": "LeonOS libc (WSL)",
            "compilerPath": "/usr/bin/clang",
            "intelliSenseMode": "linux-clang-x64",
            "cStandard": "gnu11",
            "compileCommands": "${workspaceFolder}/build/vscode/compile_commands.json",
            "includePath": ["${workspaceFolder}/include", "${workspaceFolder}/build/include", "${workspaceFolder}/build/include/generated", "${workspaceFolder}/userland/libc/include", "${workspaceFolder}/build/picolibc/sysroot/include", "${workspaceFolder}/third_party/mbedtls/include", "${workspaceFolder}/third_party/zlib", "${workspaceFolder}/third_party/libpng", "${workspaceFolder}/build/generated/libpng", "${workspaceFolder}/userland/stardustui/include", "${workspaceFolder}/third_party/stardustui"],
            "forcedInclude": ["${workspaceFolder}/build/include/generated/autoconf.h"],
            "defines": ["LEONOS_USE_PICOLIBC=1", "_POSIX_C_SOURCE=200809L", "LEONOS_LIBC=1"],
            "compilerArgs": ["-target", "x86_64-unknown-none", "-std=gnu11", "-ffreestanding", "-fno-stack-protector", "-fPIC", "-mno-red-zone", "-mgeneral-regs-only", "-ffunction-sections", "-fdata-sections", "-Wall", "-Wextra"],
            "browse": {"path": ["${workspaceFolder}/userland/libc/include", "${workspaceFolder}/build/picolibc/sysroot/include", "${workspaceFolder}/include", "${workspaceFolder}/build/include"], "limitSymbolsToIncludedHeaders": true}
        },
        {
            "name": "LeonOS Userland (WSL)",
            "compilerPath": "/usr/bin/clang",
            "intelliSenseMode": "linux-clang-x64",
            "cStandard": "gnu11",
            "cppStandard": "c++17",
            "compileCommands": "${workspaceFolder}/build/vscode/compile_commands.json",
            "includePath": ["${workspaceFolder}/include", "${workspaceFolder}/build/include", "${workspaceFolder}/build/include/generated", "${workspaceFolder}/userland", "${workspaceFolder}/userland/libc/include", "${workspaceFolder}/build/picolibc/sysroot/include", "${workspaceFolder}/third_party/mbedtls/include", "${workspaceFolder}/third_party/zlib", "${workspaceFolder}/third_party/libpng", "${workspaceFolder}/build/generated/libpng", "${workspaceFolder}/userland/stardustui/include", "${workspaceFolder}/third_party/stardustui", "${workspaceFolder}/third_party/litehtml/src", "${workspaceFolder}/third_party/doomgeneric/doomgeneric", "${workspaceFolder}/third_party/minimp3"],
            "forcedInclude": ["${workspaceFolder}/build/include/generated/autoconf.h"],
            "defines": ["LEONOS_USE_PICOLIBC=1", "_POSIX_C_SOURCE=200809L", "LEONOS_USERLAND=1"],
            "compilerArgs": ["-target", "x86_64-unknown-none", "-ffreestanding", "-fno-stack-protector", "-fPIC", "-fPIE", "-mno-red-zone", "-mgeneral-regs-only", "-ffunction-sections", "-fdata-sections", "-Wall", "-Wextra"],
            "browse": {"path": ["${workspaceFolder}/userland", "${workspaceFolder}/userland/libc/include", "${workspaceFolder}/build/picolibc/sysroot/include", "${workspaceFolder}/include", "${workspaceFolder}/build/include"], "limitSymbolsToIncludedHeaders": true}
        },
        {
            "name": "LeonOS Devtools SDK (WSL)",
            "compilerPath": "/usr/bin/clang",
            "intelliSenseMode": "linux-clang-x64",
            "cStandard": "gnu11",
            "cppStandard": "c++17",
            "compileCommands": "${workspaceFolder}/build/vscode/compile_commands.json",
            "includePath": ["${workspaceFolder}/devtools/include", "${workspaceFolder}/devtools/components/tcc/runtime/include", "${workspaceFolder}/devtools/components/tcc/port", "${workspaceFolder}/devtools/components/lua/port", "${workspaceFolder}/devtools/examples", "${workspaceFolder}/include", "${workspaceFolder}/build/include", "${workspaceFolder}/userland/libc/include", "${workspaceFolder}/build/picolibc/sysroot/include", "${workspaceFolder}/userland/stardustui/include", "${workspaceFolder}/third_party/stardustui"],
            "defines": ["LEONOS_USE_PICOLIBC=1", "_POSIX_C_SOURCE=200809L", "_DEFAULT_SOURCE=1", "LEONOS_DEVTOOLS=1"],
            "compilerArgs": ["-target", "x86_64-unknown-none", "-ffreestanding", "-fno-stack-protector", "-fPIC", "-fPIE", "-mno-red-zone", "-mgeneral-regs-only", "-Wall", "-Wextra"],
            "browse": {"path": ["${workspaceFolder}/devtools/include", "${workspaceFolder}/devtools/components/tcc/runtime/include", "${workspaceFolder}/devtools/examples"], "limitSymbolsToIncludedHeaders": true}
        }
    ]
}
